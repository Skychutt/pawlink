# 本地课程演示可以不创建 .env，以下都是可选配置。
SECRET_KEY=please-change-this-to-a-long-random-string
FLASK_DEBUG=1

# 默认使用 instance/pawlink.db，无需数据库账号密码。
# 如需切换 MySQL，安装 PyMySQL 后取消下一行注释并填写真实信息：
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/pawlink?charset=utf8mb4

# 仅在 HTTPS 部署时设置为 1，本地 HTTP 演示保持 0。
COOKIE_SECURE=0

# 暖爪 AI（密钥只能放在本机 .env，绝对不要提交到 Git）
DEEPSEEK_API_KEY=你的新密钥
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
